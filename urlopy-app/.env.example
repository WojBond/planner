# Skopiuj ten plik do .env i uzupełnij, aby wysyłać prawdziwe maile.
# Bez tych danych aplikacja działa normalnie, ale maile będą tylko logowane w konsoli.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
