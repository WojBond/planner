<!DOCTYPE html>
<html lang="pl">
<head>
  <title>Logowanie - Planer urlopow</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="login-wrap">
    <div class="card login-card">
      <h1>Planer urlopow</h1>
      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="form-row">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="form-row">
          <label for="password">Haslo</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button class="btn" type="submit" style="width:100%;">Zaloguj</button>
      </form>
      <p class="muted" style="margin-top:14px;">
        Domyslne konto administratora: <code>admin@firma.local</code> / <code>admin123</code>
      </p>
      <p class="muted" style="margin-top:6px; font-size:0.75rem;">wersja <%= appVersion %></p>
    </div>
  </div>
</body>
</html>
