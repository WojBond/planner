<!DOCTYPE html>
<html lang="pl">
<head>
  <title>Mój profil - Planer urlopów</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <div class="container">
    <div class="card">
      <h1>Mój profil</h1>
      <% if (saved) { %><div class="alert success">Zapisano zmiany.</div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <p><strong>Imie i nazwisko:</strong> <%= currentUser.name %></p>
      <p><strong>E-mail:</strong> <%= currentUser.email %></p>
      <p><strong>Dział:</strong> <%= group ? group.name : '-' %></p>
      <p><strong>Rola:</strong> <%= currentUser.role === 'admin' ? 'Administrator' : 'Użytkownik' %></p>
    </div>

    <div class="card">
      <h2>Kolor mojego paska w kalendarzu</h2>
      <form method="POST" action="/profile/color" style="display:flex; align-items:center; gap:14px;">
        <input type="color" name="color" value="<%= currentUser.color %>" />
        <button class="btn" type="submit">Zapisz kolor</button>
      </form>
    </div>

    <div class="card">
      <h2>Zmiana hasła</h2>
      <form method="POST" action="/profile/password">
        <div class="form-row">
          <label for="currentPassword">Aktualne hasło</label>
          <input type="password" id="currentPassword" name="currentPassword" required />
        </div>
        <div class="form-row">
          <label for="newPassword">Nowe hasło (min. 6 znaków)</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="6" />
        </div>
        <button class="btn" type="submit">Zmień hasło</button>
      </form>
    </div>
  </div>
</body>
</html>
