<div class="topbar">
  <div class="brand">Planer urlopów <span class="muted" style="font-weight:400; font-size:0.75rem;">v<%= appVersion %></span></div>
  <nav>
    <a href="/">Kalendarz</a>
    <a href="/profile">Mój profil</a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/users">Użytkownicy</a>
      <a href="/admin/groups">Działy</a>
    <% } %>
    <% if (currentUser) { %>
      <span class="user-badge">
        <span class="color-dot" style="background: <%= currentUser.color %>"></span>
        <%= currentUser.name %> (<%= currentUser.role === 'admin' ? 'administrator' : 'użytkownik' %>)
      </span>
      <form method="POST" action="/logout" style="margin:0;">
        <button class="btn secondary" type="submit">Wyloguj</button>
      </form>
    <% } %>
  </nav>
</div>
